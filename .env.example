# Danantara CEO Command — live Topics feed (A7 v31.0)
# Server-side only. Copy to .env.local and set the real values; also add them to
# the Vercel project (Settings → Environment Variables). Never commit real keys.

# External media-intelligence endpoint (override only if it moves).
DANANTARA_TOPICS_API_BASE=https://api.garudaperkasa.io/api-nexorus/topics
# Secret API key for the feed. Required — without it the Issues board falls back
# to seeded sample topics.
DANANTARA_TOPICS_API_KEY=
# Topic code to request (the example payload used "danantara_main").
DANANTARA_TOPIC_CODE=danantara_main
