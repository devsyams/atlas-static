# Danantara CEO Command — live Topics feed (A7 v31.0)
# Server-side only. Copy to .env.local and set the real values; also add them to
# the Vercel project (Settings → Environment Variables). Never commit real keys.

# (A7 v48.0 / A10 v6.0 — TrawlDeck cutover) The GARUDA partnership is ended; the
# topics + threats upstreams are the TrawlDeck engine's GARUDA-wire-compatible
# facade (devsyams/TrawlDeck#234). Both bases are REQUIRED — there is no default
# host anymore; unset, the routes serve their honest 503 not-configured state.
# Local dev runs the engine at http://127.0.0.1:8000.
DANANTARA_TOPICS_API_BASE=http://127.0.0.1:8000/atlas/v1/topics
DANANTARA_THREATS_API_BASE=http://127.0.0.1:8000/atlas/v1/threats
# Secret API key for the feed (shared by both endpoints; local dev keys are
# tenant-scoped `tdk_…`, scope read:atlas). Required.
DANANTARA_TOPICS_API_KEY=
# Topic code to request — a NUMERIC TrawlDeck keyword-group id (local group 1 =
# BGN). The old alphanumeric codes (danantara_main, danantara_<bumn>, …) 404
# until they get their own keyword groups.
DANANTARA_TOPIC_CODE=1

# --- Nexorus AI (LLM) ---
# Server-side only. Powers the AI briefing and the ⌘K copilot. Optional: without
# it both fall back to the deterministic scripted text (lib/ai/scripted.ts).
NEXORUS_AI_KEY=
# Optional model override. Defaults to the current Opus in lib/ai/engine.ts.
NEXORUS_AI_MODEL=

# --- JasaMarga Ops Command — live traffic (A12) ---
# TomTom Traffic API key (Flow Segment Data + Incident Details). Server-side only.
# Optional: without it the route ribbon and incident feed fall back to the
# synthetic snapshot ("Simulasi" badge instead of "● TomTom live").
TOMTOM_API_KEY=
# Optional. How long an LLM Ops analysis is cached per corridor, in minutes.
# Defaults to 60 — the dashboard re-polls every 60 s, so a short TTL would bill a
# model call every few minutes on a demo left open all day. Lower only for testing.
JASAMARGA_AI_TTL_MIN=
#
# Public sentiment on this dashboard comes from the SAME media-intelligence feed as
# /bumn-v2/jasamarga (topic code `danantara_jasamarga`), so it needs no key of its
# own — it reuses DANANTARA_TOPICS_API_{BASE,KEY} above. Without those, the Sentimen
# Publik widget falls back to the synthetic pulse (badged "Simulasi").
#
# The AI Vision panel streams PUBLIC ATCS CCTV through an on-device detector
# (YOLO11n / COCO-SSD) — no key, no cost. Optional: extra comma-separated hosts the
# same-origin CCTV proxy is allowed to fetch from, on top of the built-in registry
# (lib/jasamarga/atcs.ts). Keep this tight — it is an SSRF allowlist.
CCTV_ATCS_HOSTS=
#
# Note: the LLM Ops analysis + predictions can be switched off at runtime from
# /settings (no tokens spent while off) — see NEXORUS_AI_KEY above.

# --- Nexorus OpenGate cross-app link (P8) ---
# OpenGate autologin endpoint that mints a magic login link (override only if it
# moves). Used by BOTH the gear-menu "Nexorus Opengate" home link AND the topic
# deep link (P8 v3.0) — the latter passes &redirect=<encoded dashboard url>.
OPENGATE_AUTOLOGIN_BASE=https://opengate.nexorus.io/autologin/autologin_generate
# (v3.2) OPENGATE_API_KEY is retired — the OpenGate autologin key is the same shared
# key as the topics feed, so the OpenGate routes (topics, sentiment-trend, threats,
# autologin) all read DANANTARA_TOPICS_API_KEY directly. A separate (and easily
# mis-set) OPENGATE_API_KEY was overriding it on
# Vercel and breaking the topic deep link, so the indirection was removed.

# --- OpenGate → Danantara SSO handoff (P9, INBOUND autologin) ---
# Server-side only. DEDICATED shared secret for the inbound SSO token — the SAME
# value must be sealed into BOTH apps' k8s env. This is NOT OpenGate's AUTH_JWT_SECRET:
# OpenGate signs a short-lived HS256 JWT (iss:opengate, aud:danantara, exp=iat+120s,
# sub/email/scope) with this secret and redirects the user to
# GET /api/v1/sso?token=<jwt>; danantara verifies it (WebCrypto HMAC, zero-dep) and
# sets its own httpOnly atlas_auth/atlas_scope session. Without it, /api/v1/sso fails
# closed to /login (no token is ever trusted).
ATLAS_SSO_SECRET=

# --- Nexorus dashboard topic deep link (P8 v2.0 → v3.0) ---
# v3.0: the deep link mints through OpenGate (above) with `redirect=<query>` baked
# into the generate call. OpenGate HOSTS the dashboard and lands the user on
# https://opengate.nexorus.io/dashboard_demo?<decoded redirect> after sign-in, so
# the route sends only the query string `id=monitoring&idquery=<meta.idquery>` —
# no dashboard base is configured here. Mint uses OPENGATE_AUTOLOGIN_BASE +
# OPENGATE_API_KEY (above).
# (Retired in v3.0: NEXORUS_DASHBOARD_AUTOLOGIN_BASE, NEXORUS_DASHBOARD_API_KEY,
#  NEXORUS_DASHBOARD_BASE — OpenGate hosts the dashboard and owns the base path.)
