# Danantara CEO Command — live Topics feed (A7 v31.0)
# Server-side only. Copy to .env.local and set the real values; also add them to
# the Vercel project (Settings → Environment Variables). Never commit real keys.

# External media-intelligence endpoint (override only if it moves).
DANANTARA_TOPICS_API_BASE=https://api.garudaperkasa.io/api-nexorus/topics
# Secret API key for the feed. Required — without it the Issues board falls back
# to seeded sample topics.
DANANTARA_TOPICS_API_KEY=
# Topic code to request (the example payload used "danantara_main").
DANANTARA_TOPIC_CODE=danantara_main

# --- Nexorus OpenGate cross-app link (P8) ---
# Autologin endpoint that mints a magic login link (override only if it moves).
OPENGATE_AUTOLOGIN_BASE=https://opengate.nexorus.io/autologin/autologin_generate
# Dedicated OpenGate key. Optional today: when unset, the route falls back to
# DANANTARA_TOPICS_API_KEY (the shared key currently in use).
OPENGATE_API_KEY=

# --- Nexorus dashboard topic deep link (P8 v2.0) ---
# The dashboard (nexorus.garudaperkasa.io) is a DIFFERENT service from OpenGate.
# Its autologin mints a magic link; the topic-deeplink route 307s to it with a
# `redirect` to dashboard_demo?id=monitoring&idquery=<topic meta.idquery>.
NEXORUS_DASHBOARD_AUTOLOGIN_BASE=https://nexorus.garudaperkasa.io/autologin/autologin_generate
# Base of the dashboard page used to build the post-login redirect target.
NEXORUS_DASHBOARD_BASE=https://nexorus.garudaperkasa.io/dashboard_demo
# Dedicated key. Optional: when unset, falls back to DANANTARA_TOPICS_API_KEY.
NEXORUS_DASHBOARD_API_KEY=
